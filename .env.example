# Supabaseプロジェクトの Settings > API から取得する
# コピーして .env.local を作成し、実際の値を入れる(.env.local はgit管理対象外)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 隊形の診断(/api/review)で使う。サーバー側でしか読まないので、
# NEXT_PUBLIC_ は付けない — 付けるとブラウザへ配られ、誰でも使える。
# 空のままなら診断のボタンは「設定されていません」と答えるだけで、
# 他の機能には影響しない
GEMINI_API_KEY=
# 既定は gemini-2.0-flash。差し替えたいときだけ書く
GEMINI_MODEL=
