# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference screenshots dropped into the repo root during work sessions
/*.jpg
/*.jpeg
/*.png

# design handoff bundles exported from Claude Design (reference only, not built here).
# The export drops its loose companions in the repo root too -- the .dc.html
# reference pages, support.js, the .thumbnail preview and an uploads/ folder of
# pasted images. None of it is built or linted here; leaving support.js tracked
# would fail `npm run verify` on rules that only make sense for our own source.
/design_handoff_*/
/design_handoff_choreon_INDEX.md
/*.dc.html
/support.js
/.thumbnail
/uploads/

# Claude Code の端末ごとの設定(権限の許可リストなど)。
# スキル(.claude/skills)は共有するが、これは各自のものなので追跡しない
.claude/settings.local.json
